# DE2-115 board wrapper; BDF is authored in the Quartus GUI.
# KEY/SW I/O uses the documented JP7/VCCIO5/VCCIO6 default of 2.5 V.
# Inspect the physical board: the software cannot confirm the jumper position.
# Do not program with an unverified jumper/voltage configuration.

set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CGXFC7C7F23C8
set_global_assignment -name TOP_LEVEL_ENTITY lcd_de2_115_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY board_output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2

set_global_assignment -name BDF_FILE lcd_de2_115_top.bdf
set_global_assignment -name BDF_FILE lcd_operation_display.bdf
set_global_assignment -name QIP_FILE lcd_data_mux.qip
set_global_assignment -name VERILOG_FILE debouncer.v
set_global_assignment -name MIF_FILE control.mif
set_global_assignment -name MIF_FILE operations.mif
set_global_assignment -name SDC_FILE lcd_de2_115_top.sdc

# Terasic DE2-115 User Manual, tables 4-1/4-2/4-3/4-5/4-6, pp. 35-40:
# https://www.terasic.com.tw/attachment/archive/502/DE2_115_User_manual.pdf
set_location_assignment PIN_Y2 -to CLOCK_50
set_location_assignment PIN_M23 -to KEY[0]
set_location_assignment PIN_M21 -to KEY[1]
set_location_assignment PIN_AB28 -to SW[0]
set_location_assignment PIN_AC28 -to SW[1]
set_location_assignment PIN_AC27 -to SW[2]
set_location_assignment PIN_AD27 -to SW[3]

set_location_assignment PIN_M5 -to LCD_DATA[7]
set_location_assignment PIN_M3 -to LCD_DATA[6]
set_location_assignment PIN_K2 -to LCD_DATA[5]
set_location_assignment PIN_K1 -to LCD_DATA[4]
set_location_assignment PIN_K7 -to LCD_DATA[3]
set_location_assignment PIN_L2 -to LCD_DATA[2]
set_location_assignment PIN_L1 -to LCD_DATA[1]
set_location_assignment PIN_L3 -to LCD_DATA[0]
set_location_assignment PIN_L4 -to LCD_EN
set_location_assignment PIN_M1 -to LCD_RW
set_location_assignment PIN_M2 -to LCD_RS
set_location_assignment PIN_L5 -to LCD_ON

# Board LEDs: BUSY is LEDG[0], INIT_DONE is LEDG[1]. These pins use 2.5 V.
set_location_assignment PIN_E21 -to BUSY
set_location_assignment PIN_E22 -to INIT_DONE

set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to CLOCK_50
set_instance_assignment -name IO_STANDARD "2.5 V" -to KEY[*]
set_instance_assignment -name IO_STANDARD "2.5 V" -to SW[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LCD_DATA[*]
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LCD_EN
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LCD_RW
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LCD_RS
set_instance_assignment -name IO_STANDARD "3.3-V LVTTL" -to LCD_ON
set_instance_assignment -name IO_STANDARD "2.5 V" -to BUSY
set_instance_assignment -name IO_STANDARD "2.5 V" -to INIT_DONE

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top