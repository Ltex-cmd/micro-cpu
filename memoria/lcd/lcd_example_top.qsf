# Synchronous integration example for connecting the core to other logic.
# This project has no board pin locations or IO_STANDARD assignments.
# Use lcd_de2_115_top for the separate DE2-115 board wrapper.
# Do not program a SOF generated from this integration-only example.

set_global_assignment -name FAMILY "Cyclone IV E"
set_global_assignment -name DEVICE EP4CE115F29C7
set_global_assignment -name TOP_LEVEL_ENTITY lcd_example_top
set_global_assignment -name ORIGINAL_QUARTUS_VERSION 25.1STD.0
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY example_output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 2

set_global_assignment -name BDF_FILE lcd_example_top.bdf
set_global_assignment -name BDF_FILE lcd_operation_display.bdf
set_global_assignment -name QIP_FILE lcd_data_mux.qip
set_global_assignment -name MIF_FILE control.mif
set_global_assignment -name MIF_FILE operations.mif
set_global_assignment -name SDC_FILE lcd_example_top.sdc

set_global_assignment -name LAST_QUARTUS_VERSION "25.1std.0 Lite Edition"
set_global_assignment -name PARTITION_NETLIST_TYPE SOURCE -section_id Top
set_global_assignment -name PARTITION_FITTER_PRESERVATION_LEVEL PLACEMENT_AND_ROUTING -section_id Top
set_global_assignment -name PARTITION_COLOR 16764057 -section_id Top

set_instance_assignment -name PARTITION_HIERARCHY root_partition -to | -section_id Top
