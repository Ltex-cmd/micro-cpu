-- Formato: [15..12] operacao | [11..8] registrador destino | [7..4] dado A | [3..0] dado B
DEPTH = 16;
WIDTH = 16;
ADDRESS_RADIX = HEX;
DATA_RADIX = BIN;
CONTENT
BEGIN
0 : 0000000000000000; -- ADD A, INPUT, INPUT
1 : 0001000100000000; -- SUB B, INPUT, INPUT
2 : 0010001000000000; -- MUL C, INPUT, INPUT
3 : 0011001100000000; -- DIV D, INPUT, INPUT
4 : 0100000000000000; -- MOD A, INPUT, INPUT
5 : 0110000100000000; -- AND B, INPUT, INPUT
6 : 0111001000000000; -- OR  C, INPUT, INPUT
7 : 1000001100000000; -- XOR D, INPUT, INPUT
8 : 0000000000010010; -- ADD A, A, B
9 : 0001000100110001; -- SUB B, C, A
A : 0010001000010010; -- MUL C, A, B
B : 0110001100010011; -- AND D, A, C
C : 0111000000100011; -- OR  A, B, C
D : 1000000100010011; -- XOR B, A, C
E : 0000001000010010; -- ADD C, A, B
F : 0001001100110001; -- SUB D, C, A
END;
