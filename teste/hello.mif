-- Quartus Prime generated Memory Initialization File (.mif)

WIDTH=8;
DEPTH=16;

ADDRESS_RADIX=UNS;
DATA_RADIX=UNS;

CONTENT BEGIN
    [0..2] : 48;  -- 0x30, initialize 8-bit interface
    3 : 56;       -- 0x38, 8-bit, two lines, 5x8 font
    4 : 8;        -- 0x08, display off
    5 : 1;        -- 0x01, clear display
    6 : 6;        -- 0x06, increment cursor
    7 : 12;       -- 0x0C, display on
    8 : 72;       -- H, RS becomes 1 at address 8
    9 : 69;       -- E
    [10..11] : 76; -- L L
    12 : 79;      -- O
    [13..15] : 32; -- spaces
END;
