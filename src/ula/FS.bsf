(header "symbol" (version "1.2"))
(symbol
	(rect 64 56 192 184)
	(text "FS" (rect 5 8 20 22)(font "Intel Clear" (font_size 8)))
	(text "inst" (rect 8 88 24 100)(font "Intel Clear" ))
	(port
		(pt 88 0)
		(input)
		(text "X" (rect 0 8 8 22)(font "Intel Clear" (font_size 8)))
		(text "X" (rect 80 25 94 33)(font "Intel Clear" (font_size 8))(vertical))
		(line (pt 88 0)(pt 88 16))
	)
	(port
		(pt 32 0)
		(input)
		(text "Y" (rect 0 8 8 22)(font "Intel Clear" (font_size 8)))
		(text "Y" (rect 24 25 38 33)(font "Intel Clear" (font_size 8))(vertical))
		(line (pt 32 0)(pt 32 17))
	)
	(port
		(pt 128 80)
		(input)
		(text "Vin" (rect -88 8 -70 22)(font "Intel Clear" (font_size 8)))
		(text "Vin" (rect 85 72 103 86)(font "Intel Clear" (font_size 8)))
		(line (pt 112 80)(pt 128 80))
	)
	(port
		(pt 0 80)
		(output)
		(text "Vout" (rect 120 8 147 22)(font "Intel Clear" (font_size 8)))
		(text "Vout" (rect 24 72 51 86)(font "Intel Clear" (font_size 8)))
		(line (pt 16 80)(pt 0 80))
	)
	(port
		(pt 48 128)
		(output)
		(text "Dif" (rect 120 -72 137 -58)(font "Intel Clear" (font_size 8)))
		(text "Dif" (rect 40 87 54 104)(font "Intel Clear" (font_size 8))(vertical))
		(line (pt 48 128)(pt 48 113))
	)
	(drawing
		(rectangle (rect 16 24 120 120))
	)
)
